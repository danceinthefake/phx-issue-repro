<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title default="PhxIssueRepro" suffix=" · Phoenix Framework" phx-no-format>{assigns[:page_title]}</.live_title>
    <link phx-track-static rel="stylesheet" href={~p"/assets/default.css"} />
    <%!-- Vite-dev serves modules from :5173 in dev; prod reads the
         manifest. Without this, app.js loads as a static esbuild
         file with no live_vue hooks attached, which is why the
         original `<script>` line above breaks the Vue island. --%>
    <PhoenixVite.Components.assets
      names={["js/app.js", "css/app.css"]}
      manifest={{:phx_issue_repro, "priv/static/.vite/manifest.json"}}
      dev_server={Application.get_env(:live_vue, :vite_host) != nil}
      to_url={fn p -> static_url(@conn, p) end}
    />
  </head>
  <body>
    {@inner_content}
  </body>
</html>
